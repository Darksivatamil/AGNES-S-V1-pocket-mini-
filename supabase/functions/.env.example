# Supabase Edge Function secrets (set with: supabase secrets set --env-file ...)
# NEVER put these in web/ or firmware/.

# Base64-encoded 32-byte AES-256-GCM key used to encrypt per-user provider keys.
# Generate: openssl rand -base64 32
AGNES_CREDENTIAL_ENC_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Optional global fallback provider keys. If set, users can use the provider
# without saving a personal key. Per-user keys take precedence.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Comma-separated list of browser origins allowed by Edge Function CORS.
# Include localhost for development. Requests with no Origin (device) are
# unaffected by CORS but still require device authentication.
# Production fails closed when this list is empty; set AGNES_ENV=development
# only for local work that intentionally omits an allowlist.
AGNES_ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# Used for OpenRouter HTTP-Referer attribution (optional).
AGNES_APP_URL=https://your-vercel-app.vercel.app

# "production" enables production behavior; keep for deployed environments.
AGNES_ENV=production

# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY automatically. Do not commit their values.
